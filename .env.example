# ===== 应用 =====
APP_NAME=Moments
# 开发环境建议 false；生产部署设为 true
DEBUG=false
# 生产环境为 True 时 Cookie Secure=True
SECURE_COOKIES=false
# 是否允许在非安全上下文（HTTP / 非 localhost）下复制邀请链接到剪贴板
# 测试环境可设为 true 启用 execCommand 兜底；生产环境建议 false（应部署于 HTTPS）
ALLOW_INSECURE_CLIPBOARD=false

# ===== 数据库 (PostgreSQL) =====
# SQLAlchemy 连接串。docker-compose 默认连 db 服务（见下方 POSTGRES_*）。
# 本地开发可改为指向本机或远端 PG。
DB_URL=postgresql+psycopg://moments:moments@localhost:5432/moments

# PostgreSQL 容器凭证（docker-compose 启动 postgres:16 时使用）
POSTGRES_USER=moments
POSTGRES_PASSWORD=moments
POSTGRES_DB=moments
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== JWT / 认证 =====
# 首次启动若为空会自动生成并写回本文件
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
COOKIE_NAME=moments_token
CSRF_COOKIE_NAME=moments_csrf

# ===== 邀请链接对外域名 =====
PUBLIC_BASE_URL=http://localhost:8000

# ===== CORS =====
# 逗号分隔的允许跨域来源，空表示不允许跨域
CORS_ORIGINS=

# ===== 媒体存储 =====
STORAGE_ROOT=storage
MEDIA_IMAGE_MAX_MB=40
MEDIA_VIDEO_MAX_MB=200
THUMB_SIZE=400
LARGE_SIZE=2160
WEBP_THUMB_QUALITY=80
WEBP_LARGE_QUALITY=90

# ===== 日志 =====
LOG_DIR=logs
LOG_LEVEL=INFO

# ===== 后端宿主（dev 脚本用） =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 前端构建产物（生产静态托管） =====
FRONTEND_DIST=frontend/dist

# ===== AI 机器人 =====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_MAX_TOKENS=300
