# ===== 应用 =====
APP_NAME=Moments
# 开发环境建议 false；生产部署设为 true（启用 Secure Cookie）
SECURE_COOKIES=false

# ===== 数据库 =====
# 默认 SQLite 文件位于项目根目录 data/app.db
DB_URL=sqlite:///data/app.db

# ===== JWT / 认证 =====
# 首次启动若为空会自动生成并写回本文件
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
COOKIE_NAME=moments_token
CSRF_COOKIE_NAME=moments_csrf

# ===== 邀请链接对外域名 =====
PUBLIC_BASE_URL=http://localhost:8000

# ===== 媒体存储 =====
STORAGE_ROOT=storage
MEDIA_IMAGE_MAX_MB=40
MEDIA_VIDEO_MAX_MB=200
THUMB_SIZE=400
LARGE_SIZE=2160
WEBP_THUMB_QUALITY=80
WEBP_LARGE_QUALITY=90

# ===== 日志 =====
LOG_DIR=logs
LOG_LEVEL=INFO

# ===== 后端宿主（dev 脚本用） =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 前端构建产物（生产静态托管） =====
FRONTEND_DIST=frontend/dist